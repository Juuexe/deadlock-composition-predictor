{
  "buildCommand": "npm run check",
  "outputDirectory": "public",
  "functions": { "api/index.ts": { "includeFiles": ["docs/reliability-evaluation.json", "docs/roster-release.json"], "maxDuration": 15 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?route=:path*" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' https://assets-bucket.deadlock-api.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
  ] }]
}
